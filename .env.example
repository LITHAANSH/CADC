# ========================================================
# CADC Environment Configuration
# ========================================================

# Server Port (Local Development)
PORT=3000

# --------------------------------------------------------
# Supabase Cloud Database & Auth Configuration
# --------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API to copy your URL and Keys
# 3. Copy this file to `.env` and fill in your actual values:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --------------------------------------------------------
# Email Form Delivery (Optional Web3Forms / Resend)
# --------------------------------------------------------
WEB3FORMS_ACCESS_KEY=30d9eeb9-656d-4eb2-8afb-683ebda39278
